{
  "expo": {
    "name": "PathwayHQ",
    "slug": "pathwayhq",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pathwayhq",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10b981"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pathwayhq.app"
    },
    "android": {
      "package": "com.pathwayhq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10b981"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://ausfairgo.com.au/api"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
